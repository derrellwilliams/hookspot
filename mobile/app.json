{
  "expo": {
    "name": "Hook Spot",
    "slug": "hookspot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "hookspot",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hookspot.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.hookspot.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hook Spot uses your photos to let you add fishing spots.",
          "cameraPermission": "Hook Spot uses your camera to capture new fishing spots."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hook Spot uses your location to show nearby fishing spots."
        }
      ]
    ]
  }
}
