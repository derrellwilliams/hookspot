{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["pdx1"],
  "functions": {
    "api/catch-meta.js": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/identify", "destination": "/api/identify" },
    { "source": "/user/:username", "has": [{ "type": "query", "key": "catch" }], "destination": "/api/catch-meta?username=:username" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
