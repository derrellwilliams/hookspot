// Copy to Secrets.xcconfig (gitignored). xcconfig treats `//` as a comment,
// so write URLs as https:/$()/host.
SUPABASE_URL = https:/$()/YOUR_REF.supabase.co
// Publishable (anon) key only — never the service role key.
SUPABASE_ANON_KEY = sb_publishable_...
// Public pk. token only (URL/bundle-restricted in the Mapbox dashboard).
// The secret sk. download token belongs in ~/.netrc, never here.
MAPBOX_PUBLIC_TOKEN = pk....
// Optional: point at a local `npm run dev` server instead of production.
// API_BASE_URL = http:/$()/localhost:5173
